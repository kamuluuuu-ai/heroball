{
  "name": "heroball",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "HeroBall: fútbol 2D multijugador con superpoderes (proyecto independiente, inspirado en HaxBall)",
  "scripts": {
    "dev": "concurrently -k -n server,client -c red,blue \"node --env-file-if-exists=.env --import tsx --watch server/index.ts\" \"vite\"",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "start": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:pages": "vite build --mode pages --outDir ../dist-pages",
    "dev:db": "tsx scripts/dev-db.ts",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "admin:role": "node --env-file-if-exists=.env --import tsx scripts/role.ts",
    "admin:keygen": "node scripts/admin-keygen.mjs",
    "economy:simulate": "tsx scripts/simulate-economy.ts"
  },
  "dependencies": {
    "better-auth": "1.7.7",
    "nodemailer": "7.0.6",
    "peerjs": "1.5.5",
    "pg": "8.16.3",
    "tsx": "^4.19.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "embedded-postgres": "17.10.0-beta.17",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
