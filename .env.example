# Copiá este archivo a .env y completalo. Sin DATABASE_URL el servidor sólo
# ofrece partidas casuales (sin cuentas, economía ni partidas oficiales).

# --- Servidor ---
PORT=3001
# URL pública del backend (HTTPS en producción). Better Auth la usa para los enlaces.
PUBLIC_API_URL=http://localhost:3001
# Orígenes del frontend separados por comas (GitHub Pages y Vite local).
CORS_ORIGINS=https://kamuluuuu-ai.github.io,http://localhost:5173,http://localhost:3001

# --- Base de datos ---
# Docker: docker compose up -d   ·   Sin Docker: npm run dev:db
DATABASE_URL=postgres://heroball:heroball-local@localhost:54329/heroball
# 0 = no aplicar migraciones al arrancar (aplicalas con npm run db:migrate)
MIGRATE_ON_START=1

# --- Cuentas (Better Auth) ---
# Obligatorio con DATABASE_URL: al menos 32 caracteres aleatorios.
# Generalo con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# Correo para recuperar contraseñas (smtp://usuario:clave@servidor:587).
# Vacío: el enlace se escribe en la consola del servidor (sólo desarrollo).
SMTP_URL=
MAIL_FROM=HeroBall <no-reply@ejemplo.com>

# --- Moderación en salas P2P (opcional) ---
# Clave privada PKCS#8 en base64 (npm run admin:keygen). Sólo vive en el
# servidor: firma permisos de moderación para usuarios con rol "moderator".
MODERATOR_SIGNING_KEY=

# --- Límites de entregas administrativas (por operación) ---
ADMIN_MAX_COINS=100000
ADMIN_MAX_CHESTS=100

# --- Frontend (build de GitHub Pages) ---
# URL del backend que usa el cliente estático; vacío = sin cuentas (sólo práctica y P2P).
# VITE_API_URL=https://api.ejemplo.com
